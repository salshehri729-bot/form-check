/* ---------------------------------------------
   FormCheck AI — tokens
--------------------------------------------- */
:root {
  --bg: #0a0e13;
  --surface: #11161d;
  --surface-raised: #161d26;
  --border: #232b36;
  --border-soft: #1a2129;

  --text: #e7ebf1;
  --text-muted: #8b96a5;
  --text-faint: #576073;

  --cyan: #22d3ee;
  --cyan-dim: rgba(34, 211, 238, 0.14);
  --green: #34d399;
  --green-dim: rgba(52, 211, 153, 0.14);
  --amber: #fb923c;
  --amber-dim: rgba(251, 146, 60, 0.14);
  --red: #f87171;

  --font-display: "Space Grotesk", "Inter", sans-serif;
  --font-body: "Inter", sans-serif;

  --radius-lg: 16px;
  --radius-md: 10px;
  --radius-sm: 7px;

  color-scheme: dark;
}

* { box-sizing: border-box; }

html, body {
  height: 100%;
  margin: 0;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  line-height: 1.5;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
  background-image:
    radial-gradient(700px 400px at 85% -10%, rgba(34, 211, 238, 0.07), transparent 60%),
    radial-gradient(600px 400px at -10% 20%, rgba(52, 211, 153, 0.05), transparent 60%);
  background-attachment: fixed;
}

a { color: inherit; }

:focus-visible {
  outline: 2px solid var(--cyan);
  outline-offset: 2px;
}

/* ---------------------------------------------
   Top bar
--------------------------------------------- */
.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(10, 14, 19, 0.85);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border-soft);
  padding-top: env(safe-area-inset-top, 0px);
}

.topbar__inner {
  max-width: 1240px;
  margin: 0 auto;
  padding: 16px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 1.05rem;
  letter-spacing: -0.01em;
}

.brand__mark {
  width: 20px;
  height: 20px;
  border-radius: 6px;
  background: linear-gradient(135deg, var(--cyan), var(--green));
  flex-shrink: 0;
}

.brand__ai { color: var(--cyan); }

.exercise-tabs {
  display: flex;
  gap: 4px;
  background: var(--surface);
  border: 1px solid var(--border-soft);
  border-radius: 999px;
  padding: 4px;
}

.tab {
  appearance: none;
  border: none;
  background: transparent;
  color: var(--text-muted);
  font-family: var(--font-body);
  font-size: 0.85rem;
  font-weight: 500;
  padding: 8px 16px;
  border-radius: 999px;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
  white-space: nowrap;
}

.tab:hover { color: var(--text); }

.tab.is-active {
  background: var(--cyan-dim);
  color: var(--cyan);
}

.profile__avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: var(--surface-raised);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-muted);
}

/* ---------------------------------------------
   Dashboard grid
--------------------------------------------- */
.dashboard {
  max-width: 1240px;
  margin: 0 auto;
  padding: 32px 24px 8px;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 20px;
}

.history-panel {
  grid-column: 1 / -1;
}

@media (max-width: 860px) {
  .dashboard { grid-template-columns: 1fr; }
}

.panel {
  background: var(--surface);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius-lg);
  padding: 22px;
}

.panel__title {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 1rem;
  margin: 0 0 16px;
  color: var(--text);
}

/* ---------------------------------------------
   Upload zone
--------------------------------------------- */
.dropzone {
  position: relative;
  min-height: 360px;
  border: 1.5px dashed var(--border);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: border-color 0.15s ease, background 0.15s ease;
  overflow: hidden;
  background: var(--surface-raised);
}

.dropzone:hover,
.dropzone:focus-visible {
  border-color: var(--cyan);
  background: var(--cyan-dim);
}

.dropzone.is-dragover {
  border-color: var(--cyan);
  background: var(--cyan-dim);
}

.dropzone__empty {
  text-align: center;
  padding: 32px;
  color: var(--text-muted);
}

.dropzone__icon {
  width: 40px;
  height: 40px;
  color: var(--cyan);
  margin-bottom: 14px;
}

.dropzone__title {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 1.05rem;
  color: var(--text);
  margin: 0 0 6px;
}

.dropzone__hint {
  font-size: 0.85rem;
  margin: 0;
  color: var(--text-faint);
}

.dropzone__preview {
  width: 100%;
  height: 100%;
  position: relative;
}

.dropzone__preview video,
.dropzone__preview img {
  width: 100%;
  max-height: 360px;
  object-fit: contain;
  display: block;
  background: #000;
}

.dropzone__replace {
  position: absolute;
  bottom: 12px;
  right: 12px;
}

.pill-btn {
  appearance: none;
  border: 1px solid var(--border);
  background: rgba(10, 14, 19, 0.75);
  backdrop-filter: blur(6px);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 500;
  padding: 8px 14px;
  border-radius: 999px;
  cursor: pointer;
}

.pill-btn:hover { border-color: var(--cyan); color: var(--cyan); }

.upload-status {
  min-height: 20px;
  margin: 12px 2px 0;
  font-size: 0.82rem;
  color: var(--text-faint);
}

/* ---------------------------------------------
   Analysis panel
--------------------------------------------- */
.analysis-panel__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.analysis-empty {
  min-height: 280px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: var(--text-faint);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius-md);
  padding: 24px;
}

.analysis-empty p { margin: 0 0 6px; }
.analysis-empty__sub { font-size: 0.85rem; }

.score {
  position: relative;
  width: 68px;
  height: 68px;
  flex-shrink: 0;
}

.score__ring {
  width: 68px;
  height: 68px;
  transform: rotate(-90deg);
}

.score__track {
  fill: none;
  stroke: var(--border);
  stroke-width: 7;
}

.score__value {
  fill: none;
  stroke: var(--green);
  stroke-width: 7;
  stroke-linecap: round;
  stroke-dasharray: 213.6;
  stroke-dashoffset: 213.6;
  transition: stroke-dashoffset 0.8s ease, stroke 0.3s ease;
}

.score__text {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score__number {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 1.15rem;
  line-height: 1;
}

.score__label {
  font-size: 0.55rem;
  color: var(--text-faint);
  margin-top: 2px;
  text-transform: lowercase;
}

.checklist {
  list-style: none;
  margin: 18px 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.check-item {
  display: flex;
  gap: 12px;
  padding: 14px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-soft);
  background: var(--surface-raised);
}

.check-item__dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  margin-top: 6px;
  flex-shrink: 0;
}

.check-item.is-good .check-item__dot { background: var(--green); box-shadow: 0 0 8px var(--green); }
.check-item.is-risk .check-item__dot { background: var(--amber); box-shadow: 0 0 8px var(--amber); }

.check-item__body { flex: 1; min-width: 0; }

.check-item__title {
  font-weight: 600;
  font-size: 0.92rem;
  margin: 0;
}

.check-item.is-good .check-item__title { color: var(--green); }
.check-item.is-risk .check-item__title { color: var(--amber); }

.check-item__tip {
  margin: 4px 0 0;
  font-size: 0.85rem;
  color: var(--text-muted);
}

.primary-btn {
  appearance: none;
  width: 100%;
  margin-top: 18px;
  border: none;
  border-radius: var(--radius-sm);
  padding: 12px;
  background: var(--cyan);
  color: #04202a;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.9rem;
  cursor: pointer;
  transition: filter 0.15s ease;
}

.primary-btn:hover { filter: brightness(1.08); }

/* ---------------------------------------------
   History
--------------------------------------------- */
.history-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 12px;
}

.history-item {
  border: 1px solid var(--border-soft);
  background: var(--surface-raised);
  border-radius: var(--radius-md);
  padding: 14px;
}

.history-item__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.history-item__name {
  font-weight: 600;
  font-size: 0.88rem;
}

.history-item__score {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.88rem;
}

.history-item__score.good { color: var(--green); }
.history-item__score.risk { color: var(--amber); }

.history-item__date {
  font-size: 0.78rem;
  color: var(--text-faint);
  margin: 0;
}

/* ---------------------------------------------
   Footnote
--------------------------------------------- */
.footnote {
  max-width: 1240px;
  margin: 0 auto;
  padding: 20px 24px 40px;
}

.footnote p {
  font-size: 0.78rem;
  color: var(--text-faint);
  margin: 0;
}

.footnote code {
  background: var(--surface-raised);
  border: 1px solid var(--border-soft);
  border-radius: 4px;
  padding: 1px 6px;
  font-size: 0.75rem;
}

@media (prefers-reduced-motion: reduce) {
  .score__value { transition: none; }
}
